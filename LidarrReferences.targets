<Project>
  <PropertyGroup>
    <!-- Must equal VERSION in scripts/prepare-lidarr.py and SupportedLidarrVersion in AssemblySmokeTests.cs. -->
    <LidarrAssemblyVersion>3.1.3.4968</LidarrAssemblyVersion>
    <LidarrReferenceDir>$(MSBuildThisFileDirectory)_temp/lidarr/$(LidarrAssemblyVersion)</LidarrReferenceDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(LidarrReferenceDir)/Lidarr.Core.dll;$(LidarrReferenceDir)/Lidarr.Common.dll;$(LidarrReferenceDir)/Lidarr.Http.dll;$(LidarrReferenceDir)/Lidarr.Api.V1.dll;$(LidarrReferenceDir)/NLog.dll;$(LidarrReferenceDir)/FluentValidation.dll;$(LidarrReferenceDir)/Newtonsoft.Json.dll;$(LidarrReferenceDir)/System.IO.Abstractions.dll">
      <Private Condition="'$(IsTestProject)' == 'true'">true</Private>
      <Private Condition="'$(IsTestProject)' != 'true'">false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireLidarrReferences" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <LidarrGuardedAssembly Include="$(LidarrReferenceDir)/Lidarr.Core.dll;$(LidarrReferenceDir)/Lidarr.Common.dll;$(LidarrReferenceDir)/Lidarr.Http.dll;$(LidarrReferenceDir)/Lidarr.Api.V1.dll" />
    </ItemGroup>
    <Error Condition="!Exists('%(LidarrGuardedAssembly.FullPath)')" Text="Missing %(LidarrGuardedAssembly.FullPath). Run python3 scripts/prepare-lidarr.py before building." />
    <!-- Plugins built against the wrong Lidarr assembly version crash at load time, so check the real AssemblyVersion, not just the path. -->
    <GetAssemblyIdentity AssemblyFiles="@(LidarrGuardedAssembly)">
      <Output TaskParameter="Assemblies" ItemName="LidarrGuardedIdentity" />
    </GetAssemblyIdentity>
    <Error Condition="'%(LidarrGuardedIdentity.Version)' != '$(LidarrAssemblyVersion)'" Text="Lidarr assembly version mismatch: %(LidarrGuardedIdentity.Identity) is %(LidarrGuardedIdentity.Version) but this plugin requires $(LidarrAssemblyVersion) (LidarrAssemblyVersion in LidarrReferences.targets). Re-run python3 scripts/prepare-lidarr.py, or update the version in LidarrReferences.targets, scripts/prepare-lidarr.py and AssemblySmokeTests.cs together." />
  </Target>
</Project>
