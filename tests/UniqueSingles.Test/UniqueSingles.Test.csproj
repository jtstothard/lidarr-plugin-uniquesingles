<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Allow running on .NET 10 SDK when .NET 8 runtime is not installed -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="SingleCleanupServiceTests.cs" />
    <Compile Include="Matching/TrackMatcherTests.cs" />
    <Compile Include="SingleCleanupOptionsTests.cs" />
    <Compile Include="UniqueSinglesImportCoordinatorTests.cs" />
    <Compile Include="UniqueSinglesNotificationTests.cs" />
    <Compile Include="ScheduledTaskServiceTests.cs" />
    <Compile Include="UniqueSinglesScanTaskTests.cs" />
    <Compile Include="AssemblySmokeTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UniqueSingles\UniqueSingles.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <Import Project="../../LidarrReferences.targets" />
  <!-- Exercise the host container registration and lifecycle dispatch using pinned binaries. -->
  <ItemGroup>
    <Reference Include="DryIoc" HintPath="$(LidarrReferenceDir)/DryIoc.dll" />
    <Reference Include="DryIoc.Microsoft.DependencyInjection" HintPath="$(LidarrReferenceDir)/DryIoc.Microsoft.DependencyInjection.dll" />
  </ItemGroup>
</Project>
